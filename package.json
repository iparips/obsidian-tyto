{
  "name": "tyto",
  "version": "0.4.0",
  "description": "Edit your notes by voice. Speak an instruction and the note changes, with no fixed command phrases.",
  "main": "main.js",
  "scripts": {
    "build": "bun build src/main.ts --outdir . --entry-naming \"[name].[ext]\" --external obsidian --format cjs",
    "verify": "bun run typecheck && bun run test && bun run lint && bun run format && bun run build",
    "version:major": "bun run version-bump.mjs major",
    "version:minor": "bun run version-bump.mjs minor",
    "version:patch": "bun run version-bump.mjs patch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --log-level warn",
    "test": "vitest run --reporter=verbose --no-watch"
  },
  "keywords": [],
  "author": "Ilya Paripsa",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.0.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "eslint": "^9",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "happy-dom": "^20.0.0",
    "obsidian": ">=1.5.0",
    "prettier": "^3.5.3",
    "tslib": "2.4.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^1.3.1"
  },
  "dependencies": {
    "chrono-node": "2.10.1",
    "date-fns": "^4.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
